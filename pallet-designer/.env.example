# Environment Variables for Pallet Designer
# Copy this file to .env and fill in the values

# Base URL for the application (optional, defaults to './')
# VITE_BASE_URL=/

# Enable debug mode (optional, for development)
# VITE_DEBUG=false

# API endpoint for future cloud features (optional)
# VITE_API_URL=https://api.example.com

# Analytics tracking ID (optional)
# VITE_ANALYTICS_ID=

# Note: All VITE_ prefixed variables are exposed to the client-side code
# Do not put sensitive secrets here
